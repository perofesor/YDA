# ============================================================================
#  YDA — Environment configuration
#  کپی کنید به `.env` و مقادیر را ویرایش کنید:  cp .env.example .env
#  ⚠️ فایل `.env` را هرگز در گیت کامیت نکنید (در .gitignore هست).
# ============================================================================

PORT=8100
NODE_ENV=production

# 🔐 کلید امضای توکن — حتماً یک مقدار تصادفی و بلند بگذارید.
# تولید: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# اگر خالی یا مقدار پیش‌فرض باشد، سرور یک کلید تصادفی موقت می‌سازد و هشدار می‌دهد.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# 🔐 حساب ادمین اولیه — پس از اولین ورود، رمز را از پنل تغییر دهید و اینجا هم عوض کنید.
ADMIN_EMAIL=admin@yda.studio
ADMIN_PASSWORD=change_this_strong_password

# آدرس کامل سایت (برای sitemap/SEO و کوکی Secure روی HTTPS)
SITE_URL=https://your-domain.com

MAX_UPLOAD_MB=25
